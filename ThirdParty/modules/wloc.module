#!name=Newloc WLOC (Shadowrocket)
#!desc=配合「Newloc」应用改写 Apple 定位服务响应。本文件适用于 Shadowrocket（小火箭）。
#!author=Newloc
#!homepage=https://github.com/Lululu-0715/Newloc

# ─────────────────────────────────────────────────────────────
#  本文件仅供 Shadowrocket（小火箭）导入。
#  格式特征：[Script] 段 + type=http-response / http-request。
#
#  ⚠️ 1.0.7 及以前这里写的是 [Rewrite] 段配 `url script-response-body`，
#     小火箭**不认这个段名**，导入时会直接判为无效模块。
#     小火箭的模块段名只有 [General] [Rule] [Host] [URL Rewrite]
#     [Header Rewrite] [Body Rewrite] [Map Local] [Script] [MITM]，
#     脚本一律走 [Script] 段（与 Surge 模块同格式）。
#
#  其他客户端请改用对应文件（功能完全一致，只是格式不同）：
#    Surge / Egern   → wloc.sgmodule
#    Quantumult X    → wloc.conf
#    Loon            → wloc.lpx
#    Stash           → wloc.stoverride
#  对照表见同目录的 README.md
#
#  导入后请开启本模块，并确认 MITM 已启用。切勿给下方主机名添加
#  DIRECT 规则——那会让流量绕过代理，规则永远不会触发。
# ─────────────────────────────────────────────────────────────

[Script]
# 定位响应改写：拦下 Apple 定位服务返回的经纬度并替换成目标坐标。
#
# binary-body-mode=1 不能省：定位响应是 protobuf 二进制，不开这个开关时
# 客户端会先按 UTF-8 解码再交给脚本，高位字节被替换成 U+FFFD，脚本还原
# 出来的字节流已经坏了——表现就是「模块在跑、坐标也写进去了，定位纹丝不动」。
#
# max-size=0 表示不限制，避免响应稍大就静默跳过。
wloc-rewrite = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp(?:-|\d+-|e\d+(?:-\d+)?-)ssl\.(?:ls\.)?apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://cdn.jsdelivr.net/gh/Lululu-0715/Newloc@main/ThirdParty/ProxyScripts/wloc.js

# 配置接口：应用通过这个请求把目标坐标写进客户端存储。
# 这个请求不真的出网，由脚本直接回一个 JSON，所以要给足 timeout。
wloc-settings = type=http-request,pattern=^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save,requires-body=0,max-size=0,timeout=10,script-path=https://cdn.jsdelivr.net/gh/Lululu-0715/Newloc@main/ThirdParty/ProxyScripts/wloc-settings.js

[MITM]
# %APPEND% 保证不覆盖用户已有的 MITM 配置。
#
# 重要：这些主机名必须经过 MITM 才能被拦截。
# 绝不要给它们加 DOMAIN,...,DIRECT 规则——那会让流量绕过代理，
# 改写规则看起来装好了却永远不会触发。
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, gsp10-ssl.ls.apple.com, gsp10-ssl.apple.com, gsp64-ssl.ls.apple.com, gspe1-ssl.ls.apple.com, gspe19-ssl.ls.apple.com, gspe19-2-ssl.ls.apple.com, gspe35-ssl.ls.apple.com, gspe79-ssl.ls.apple.com, gspe85-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
