#!name=Newloc WLOC (Loon)
#!desc=配合「Newloc」应用改写 Apple 定位服务响应。本文件适用于 Loon。
#!author=Newloc
#!homepage=https://github.com/Lululu-0715/Newloc

# ─────────────────────────────────────────────────────────────
#  本文件仅供 Loon 导入。
#  格式特征：#!name= 开头的插件格式，[Script] 段用 script-path= 声明。
#
#  其他客户端请改用对应文件（功能完全一致，只是格式不同）：
#    Shadowrocket    → wloc.module
#    Surge / Egern   → wloc.sgmodule
#    Quantumult X    → wloc.conf
#    Stash           → wloc.stoverride
#  对照表见同目录的 README.md
#
#  导入后请开启本模块，并确认 MITM 已启用。切勿给下方主机名添加
#  DIRECT 规则——那会让流量绕过代理，规则永远不会触发。
# ─────────────────────────────────────────────────────────────

[Script]
# binary-body-mode=true 不能省：定位响应是 protobuf 二进制，不开这个开关时
# 客户端会先按 UTF-8 解码再交给脚本，高位字节被替换成 U+FFFD，脚本还原
# 出来的字节流已经坏了——表现就是「模块在跑、坐标也写进去了，定位纹丝不动」。
http-response ^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp(?:-|\d+-|e\d+(?:-\d+)?-)ssl\.(?:ls\.)?apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc script-path=https://cdn.jsdelivr.net/gh/Lululu-0715/Newloc@main/ThirdParty/ProxyScripts/wloc.js, requires-body=true, binary-body-mode=true, max-size=0, timeout=30, tag=WLOC 定位改写
http-request ^https?:\/\/gs-loc(-cn)?\.apple\.com\/wloc-settings\/save script-path=https://cdn.jsdelivr.net/gh/Lululu-0715/Newloc@main/ThirdParty/ProxyScripts/wloc-settings.js, requires-body=false, timeout=10, tag=WLOC 配置接口

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, gsp10-ssl.ls.apple.com, gsp10-ssl.apple.com, gsp64-ssl.ls.apple.com, gspe1-ssl.ls.apple.com, gspe19-ssl.ls.apple.com, gspe19-2-ssl.ls.apple.com, gspe35-ssl.ls.apple.com, gspe79-ssl.ls.apple.com, gspe85-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
